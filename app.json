{
  "expo": {
    "name": "Förköp",
    "slug": "forkop",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "forkop",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.agatonwp.forkop",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "swish"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Appen behöver tillgång till dina bilder för att du ska kunna välja en profilbild.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/with-fmt-xcode26-fix",
      "expo-notifications",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.327088324957-2nggu18as7c9gqc97ef3qinnjndml6ul"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "72d048eb-2907-4d62-aa93-c2e57b09b1f1"
      },
      "google": {
        "iosClientId": "327088324957-2nggu18as7c9gqc97ef3qinnjndml6ul.apps.googleusercontent.com",
        "webClientId": "327088324957-lp0n4ad84ekn79fmnchhkg5ddejokele.apps.googleusercontent.com"
      }
    },
    "owner": "agatonwp"
  }
}
